[node name="TitleLabel" type="Label" parent="Column/Header/HeaderBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Materials and equipment"
autowrap_mode = 3

[node name="SubtitleLabel" type="Label" parent="Column/Header/HeaderBox"]
layout_mode = 2
