[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/library_panel.gd" id="1"]

[node name="LibraryPanel" type="PanelContainer" node_paths=PackedStringArray("subtitle_label", "content_box")]
custom_minimum_size = Vector2(260, 0)
theme_type_variation = &"SidePanel"
script = ExtResource("1")
subtitle_label = NodePath("Column/Header/HeaderBox/SubtitleLabel")
content_box = NodePath("Column/Scroll/Margin/Content")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Header" type="PanelContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"HeaderPanel"

[node name="HeaderBox" type="VBoxContainer" parent="Column/Header"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Column/Header/HeaderBox"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
